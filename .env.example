# API service
PORT=4000
NODE_ENV=development

# AWS / Bedrock
AWS_REGION=us-east-1
# Recommended Claude 3.5 Sonnet on Bedrock (adjust if needed)
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
# If using AWS profiles/roles, normal AWS auth chain applies; else set below
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Web app
NEXT_PUBLIC_API_URL=http://localhost:4000
